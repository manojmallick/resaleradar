# ─────────────────────────────────────────────────────────────
# ResaleRadar environment. Copy to .env.local (git-ignored).
# Never commit real credentials.
# ─────────────────────────────────────────────────────────────

# ── Database (Amazon Aurora PostgreSQL + pgvector) ────────────
# PREFERRED: Vercel Amazon Aurora PostgreSQL integration (IAM/OIDC, no password).
# Injected when you connect the integration to the project; pull with:
#   vercel env pull .env.local
# PGHOST=...rds.amazonaws.com
# PGPORT=5432
# PGUSER=...
# PGDATABASE=postgres
# AWS_ROLE_ARN=arn:aws:iam::...:role/...
# VERCEL_OIDC_TOKEN=...   # provided by `vercel env pull` for local IAM auth (short-lived)

# FALLBACK: a plain connection string (local Postgres or generic Aurora).
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/resaleradar
# PGSSLMODE=require        # set "disable" for a local non-TLS Postgres

# ── Amazon Bedrock (vision + multimodal embeddings + listing copy) ──
# Region must have model access granted for the models below.
AWS_REGION=us-east-1
# Bedrock credentials. On Vercel these can come from an OIDC role; for local
# `npm run db:seed` you typically need a key/secret with bedrock:InvokeModel:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=      # only if using temporary credentials
# BEDROCK_REGION=         # override if Bedrock model access is in a different region

# Vision + listing copy (multimodal Claude on Bedrock):
BEDROCK_LLM_MODEL_ID=anthropic.claude-sonnet-4-6
# Multimodal image embeddings (image + text in one 1024-dim space):
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-image-v1
EMBED_DIM=1024            # Titan Multimodal default. MUST match db/schema.sql vector(N).

# ── Demo ──────────────────────────────────────────────────────
# DEMO_USER_EMAIL=demo@resaleradar.app
